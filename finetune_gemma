6-10-23T05:55:06.270942Z","iopub.status.busy":"2026-10-23T05:55:06.270725Z","iopub.status.idle":"2026-10-23T05:55:06.277575Z","shell.execute_reply":"2026-10-23T05:55:06.276865Z"},"papermill":{"duration":0.013712,"end_time":"2026-10-23T05:55:06.279009+00:00","exception":false,"start_time":"2026-10-23T05:55:06.265297+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["✅ Configuration set\n","   Model variant    : gemma-3-4b-it\n","   LoRA rank        : 16\n","   Effective batch  : 16\n","   Learning rate    : 0.0002\n","   Max seq length   : 512\n","   Save every steps : 10\n"]}],"source":["OUTPUT_DIR  = \"/kaggle/working/checkpoints\"\n","ADAPTER_DIR = \"/kaggle/working/checkpoints/final_adapter\"\n","\n","# ── Checkpoint / Resume ───────────────────────────────────────────────────────\n","# True  → resume from latest checkpoint automatically\n","# False → start fresh\n","# str   → resume from that specific checkpoint directory\n","RESUME_FROM_CHECKPOINT = True\n","\n","# ── Training hyperparameters ──────────────────────────────────────────────────\n","# Tuned for Gemma 3 4B on T4 × 2 with QLoRA\n","# For 12B: lower BATCH_SIZE to 1\n","LORA_R        = 16\n","LORA_ALPHA    = 32\n","LORA_DROPOUT  = 0.05\n","MAX_SEQ_LEN   = 512\n","BATCH_SIZE    = 2     # use 1 for 12B\n","GRAD_ACCUM    = 8     # effective batch = 16\n","LR            = 2e-4\n","EPOCHS        = 1\n","WARMUP_STEPS  = 10\n","SAVE_STEPS    = 10    # save every 10 steps — frequent enough to survive Kaggle kills\n","\n","# ── Prompt templates (Gemma 3 text summarization) ─────────────────────────────\n","STYLE_TEMPLATES = {\n","    \"short\": (\n","        \"You are an expert AI news summarizer. \"\n","        \"Write a concise 2–3 sentence summary of the following article. \"\n","        \"Preserve key entities, dates, and findings.\\n\\nArticle:\\n{article}\\n\\nSummary:\"\n","    ),\n","    \"bullet\": (\n","        \"You are an expert AI news summarizer. \"\n","        \"Extract the 4–6 most important points from the article as concise bullet points.\\n\\n\"\n","        \"Article:\\n{article}\\n\\nKey Points:\"\n","    ),\n","    \"headline\": (\n","        \"You are an expert AI news editor. \"\n","        \"First write a punchy headline, then write a 2-sentence summary.\\n\\n\"\n","        \"Article:\\n{article}\\n\\nHeadline and Summary:\"\n","    ),\n","    \"detailed\": (\n","        \"You are an expert AI news analyst. \"\n","        \"Provide a detailed structured summary with: \"\n","        \"1) Headline 2) Main Summary (3–4 sentences) \"\n","        \"3) Key Points (bullet list) 4) Takeaway (one sentence).\\n\\n\"\n","        \"Article:\\n{article}\\n\\nStructured Summary:\"\n","    ),\n","}\n","\n","# Gemma 3 uses the same <start_of_turn> / <end_of_turn> chat template as Gemma 2\n","CHAT_TEMPLATE = (\n","    \"<start_of_turn>user\\n{prompt}<end_of_turn>\\n\"\n","    \"<start_of_turn>model\\n{response}<end_of_turn>\"\n",")\n","\n","print(\"✅ Configuration set\")\n","print(f\"   Model variant    : {KAGGLE_MODEL_HANDLE.split('/')[-1]}\")\n","print(f\"   LoRA rank        : {LORA_R}\")\n","print(f\"   Effective batch  : {BATCH_SIZE * GRAD_ACCUM}\")\n","print(f\"   Learning rate    : {LR}\")\n","print(f\"   Max seq length   : {MAX_SEQ_LEN}\")\n","print(f\"   Save every steps : {SAVE_STEPS}\")"]},{"cell_type":"markdown","id":"228058f0","metadata":{"papermill":{"duration":0.004449,"end_time":"2026-10-23T05:55:06.287866+00:00","exception":false,"start_time":"2026-10-23T05:55:06.283417+00:00","status":"completed"},"tags":[]},"source":["## 4b. Checkpoint Detection\n","\n","This cell resolves the `RESUME_FROM_CHECKPOINT` setting to a concrete path\n","(or `None` for a fresh start) and lists all available checkpoints."]},{"cell_type":"code","execution_count":5,"id":"07719c67","metadata":{"execution":{"iopub.execute_input":"2026-10-23T05:55:06.297783Z","iopub.status.busy":"2026-10-23T05:55:06.297526Z","iopub.status.idle":"2026-10-23T05:55:06.306082Z","shell.execute_reply":"2026-10-23T05:55:06.304995Z"},"papermill":{"duration":0.015326,"end_time":"2026-10-23T05:55:06.307556+00:00","exception":false,"start_time":"2026-10-23T05:55:06.29223+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["🆕 No checkpoint found — starting a fresh training run.\n","   Checkpoints will be saved to: /kaggle/working/checkpoints\n"]}],"source":["def _find_latest_checkpoint(output_dir: str) -> str | None:\n","    \"\"\"Return the checkpoint directory with the highest step number, or None.\"\"\"\n","    pattern    = os.path.join(output_dir, \"checkpoint-*\")\n","    candidates = [c for c in glob.glob(pattern) if os.path.isdir(c)]\n","    if not candidates:\n","        return None\n","\n","    def _step(path):\n","        m = re.search(r\"checkpoint-(\\d+)$\", path)\n","        return int(m.group(1)) if m else -1\n","\n","    return max(candidates, key=_step)\n","\n","\n","# ── Resolve to a concrete path ────────────────────────────────────────────────\n","if isinstance(RESUME_FROM_CHECKPOINT, str):\n","    _resume_path = RESUME_FROM_CHECKPOINT\n","    if not os.path.isdir(_resume_path):\n","        raise FileNotFoundError(\n","            f\"Checkpoint directory not found: {_resume_path!r}\\n\"\n","            \"Check the path or set RESUME_FROM_CHECKPOINT = False.\"\n","        )\n","elif RESUME_FROM_CHECKPOINT is True:\n","    _resume_path = _find_latest_checkpoint(OUTPUT_DIR)\n","else:\n","    _resume_path = None\n","\n","# ── Report ────────────────────────────────────────────────────────────────────\n","if _resume_path:\n","    all_ckpts = sorted(\n","        glob.glob(os.path.join(OUTPUT_DIR, \"checkpoint-*\")),\n","        key=lambda p: int(re.search(r\"checkpoint-(\\d+)$\", p).group(1))\n","        if re.search(r\"checkpoint-(\\d+)$\", p) else -1,\n","    )\n","    print(\"📂 Available checkpoints:\")\n","    for ckpt in all_ckpts:\n","        marker = \"  ← RESUMING\" if ckpt == _resume_path else \"\"\n","        print(f\"   {ckpt}{marker}\")\n","    print(f\"\\n♻️  Will resume from: {_resume_path}\")\n","else:\n","    print(\"🆕 No checkpoint found — starting a fresh training run.\")\n","    print(f\"   Checkpoints will be saved to: {OUTPUT_DIR}\")"]},{"cell_type":"markdown","id":"04078fa8","metadata":{"papermill":{"duration":0.004366,"end_time":"2026-10-23T05:55:06.316242+00:00","exception":false,"start_time":"2026-10-23T05:55:06.311876+00:00","status":"completed"},"tags":[]},"source":["## 5. Load Tokenizer\n","\n","Gemma 3 is **text-only**, so we use the standard `AutoTokenizer` —\n","no `AutoProcessor`, no multimodal overhead."]},{"cell_type":"code","execution_count":6,"id":"5b1dafa5","metadata":{"execution":{"iopub.execute_input":"2026-10-23T05:55:06.3265Z","iopub.status.busy":"2026-10-23T05:55:06.325857Z","iopub.status.idle":"2026-10-23T05:55:10.324216Z","shell.execute_reply":"2026-10-23T05:55:10.323222Z"},"papermill":{"duration":4.005099,"end_time":"2026-10-23T05:55:10.325686+00:00","exception":false,"start_time":"2026-10-23T05:55:06.320587+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Loading tokenizer from local model path …\n","✅ Vocab size    : 262,144\n","   Pad token    : '<pad>'\n","   EOS token    : '<eos>'\n","   BOS token    : '<bos>'\n"]}],"source":["print(\"Loading tokenizer from local model path …\")\n","tokenizer = AutoTokenizer.from_pretrained(MODEL_PATH)\n","\n","# Gemma 3 has a dedicated <pad> token — no need to reuse <eos>\n","if tokenizer.pad_token is None:\n","    tokenizer.pad_token = tokenizer.eos_token\n","\n","# padding_side=\"right\" is required for correct SFT loss masking\n","tokenizer.padding_side = \"right\"\n","\n","print(f\"✅ Vocab size    : {tokenizer.vocab_size:,}\")\n","print(f\"   Pad token    : {tokenizer.pad_token!r}\")\n","print(f\"   EOS token    : {tokenizer.eos_token!r}\")\n","print(f\"   BOS token    : {tokenizer.bos_token!r}\")"]},{"cell_type":"markdown","id":"ef1bec1c","metadata":{"papermill":{"duration":0.004696,"end_time":"2026-10-23T05:55:10.335485+00:00","exception":false,"start_time":"2026-10-23T05:55:10.330789+00:00","status":"completed"},"tags":[]},"source":["## 6. Load Dataset\n","\n","**Option A** — Attach your Kaggle Dataset `deetyam/gemma-news-data`\n","(Add-ons → Datasets), which provides `train.jsonl` and `val.jsonl`.\n","\n","**Option B** — Place `sample_dataset.jsonl` directly under `/kaggle/input/`.\n","\n","Each JSONL record must have keys:\n","- `article` (str) — the news article text\n","- `summary` (str) — the target summary\n","- `style` (str) — one of `short`, `bullet`, `headline`, `detailed`\n","- `headline` (str, optional)\n","- `key_points` (list[str], optional)"]},{"cell_type":"code","execution_count":7,"id":"a98ee4a0","metadata":{"execution":{"iopub.execute_input":"2026-10-23T05:55:10.34714Z","iopub.status.busy":"2026-10-23T05:55:10.346673Z","iopub.status.idle":"2026-10-23T05:55:10.582009Z","shell.execute_reply":"2026-10-23T05:55:10.581126Z"},"papermill":{"duration":0.243377,"end_time":"2026-10-23T05:55:10.583775+00:00","exception":false,"start_time":"2026-10-23T05:55:10.340398+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["\n","✅ Dataset loaded:\n","   Train : 844 examples\n","   Val   : 105 examples\n","\n","Sample text (first 400 chars):\n","<start_of_turn>user\n","You are an expert AI news analyst. Provide a detailed structured summary with: 1) Headline 2) Main Summary (3–4 sentences) 3) Key Points (bullet list) 4) Takeaway (one sentence).\n","\n","Article:\n","By . Mark Prigg . It is already locked in a battle with New York's iconic yellow cabs, but now Uber has declared war on them by cutting its prices. The firm boasted today it will undercut cab\n"]}],"source":["def load_jsonl(path: str) -> list[dict]:\n","    records = []\n","    with open(path, encoding=\"utf-8\") as f:\n","        for line in f:\n","            line = line.strip()\n","            if line:\n","                records.append(json.loads(line))\n","    return records\n","\n","\n","def build_target(record: dict) -> str:\n","    \"\"\"Build the model's target output from a dataset record.\"\"\"\n","    style      = record.get(\"style\", \"detailed\")\n","    summary    = record.get(\"summary\", \"\")\n","    headline   = record.get(\"headline\", \"\")\n","    key_points = record.get(\"key_points\", [])\n","\n","    if style == \"short\":\n","        return summary\n","    if style == \"bullet\":\n","        pts = key_points or [s.strip() for s in summary.split(\".\") if s.strip()]\n","        return \"\\n\".join(f\"• {p}\" for p in pts[:5])\n","    if style == \"headline\":\n","        return f\"**{headline}**\\n\\n{summary}\" if headline else summary\n","\n","    # detailed\n","    parts = []\n","    if headline:   parts.append(f\"**Headline:** {headline}\")\n","    if summary:    parts.append(f\"\\n**Summary:** {summary}\")\n","    if key_points:\n","        pts = \"\\n\".join(f\"• {p}\" for p in key_points)\n","        parts.append(f\"\\n**Key Points:**\\n{pts}\")\n","    takeaway = key_points[-1] if key_points else \"\"\n","    if takeaway:   parts.append(f\"\\n**Takeaway:** {takeaway}\")\n","    return \"\\n\".join(parts)\n","\n","\n","def format_record(record: dict) -> dict:\n","    \"\"\"Format a dataset record into a single text string for SFT.\"\"\"\n","    style  = record.get(\"style\", \"detailed\")\n","    prompt = STYLE_TEMPLATES[style].format(article=record[\"article\"].strip())\n","    target = build_target(record)\n","    text   = CHAT_TEMPLATE.format(prompt=prompt, response=target)\n","    return {\"text\": text}\n","\n","\n","# ── Resolve dataset paths ─────────────────────────────────────────────────────\n","TRAIN_FILE = \"/kaggle/input/datasets/deetyam/gemma-news-data/train.jsonl\"\n","VAL_FILE   = \"/kaggle/input/datasets/deetyam/gemma-news-data/val.jsonl\"\n","\n","if not Path(TRAIN_FILE).exists():\n","    print(\"⚠ Processed splits not found — falling back to sample_dataset.jsonl\")\n","    TRAIN_FILE = \"/kaggle/input/gemma-news-summarizer/data/sample_dataset.jsonl\"\n","    VAL_FILE   = None\n","\n","train_records = load_jsonl(TRAIN_FILE)\n","val_records   = load_jsonl(VAL_FILE) if VAL_FILE and Path(VAL_FILE).exists() else train_records[:10]\n","\n","train_data = [format_record(r) for r in train_records]\n","val_data   = [format_record(r) for r in val_records]\n","\n","ds = DatasetDict({\n","    \"train\":      Dataset.from_list(train_data),\n","    \"validation\": Dataset.from_list(val_data),\n","})\n","\n","print(f\"\\n✅ Dataset loaded:\")\n","print(f\"   Train : {len(ds['train'])} examples\")\n","print(f\"   Val   : {len(ds['validation'])} examples\")\n","print(f\"\\nSample text (first 400 chars):\")\n","print(ds[\"train\"][0][\"text\"][:400])"]},{"cell_type":"markdown","id":"4a3a6a55","metadata":{"papermill":{"duration":0.004494,"end_time":"2026-10-23T05:55:10.593148+00:00","exception":false,"start_time":"2026-10-23T05:55:10.588654+00:00","status":"completed"},"tags":[]},"source":["## 7. Load Base Model in 4-bit (QLoRA)\n","\n","### Key fixes vs. the previous Gemma 4 notebook\n","\n","| Issue | Old (broken) | New (fixed) |\n","|---|---|---|\n","| dtype | `torch_dtype=torch.float16` (deprecated) | `dtype=torch.float16` ✅ |\n","| device_map | `{\"\":0}` (pins to GPU 0 only!) | `\"auto\"` (uses both T4s) ✅ |\n","| Model architecture | Multimodal (vision tower) | Text-only ✅ |\n","\n","> **Why FP16, not BF16?**  \n","> T4 GPUs do **not** support bfloat16 natively. Using `bf16=True` causes\n","> silent hangs mid-training. FP16 is fully supported and equally stable for QLoRA."]},{"cell_type":"code","execution_count":8,"id":"bdc4f235","metadata":{"execution":{"iopub.execute_input":"2026-10-23T05:55:10.603474Z","iopub.status.busy":"2026-10-23T05:55:10.603239Z","iopub.status.idle":"2026-10-23T05:55:45.08169Z","shell.execute_reply":"2026-10-23T05:55:45.080882Z"},"papermill":{"duration":34.485693,"end_time":"2026-10-23T05:55:45.083346+00:00","exception":false,"start_time":"2026-10-23T05:55:10.597653+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Loading model from: /kaggle/input/models/google/gemma-3/transformers/gemma-3-4b-it/1\n","(4-bit NF4 + double quantisation, device_map='auto' across both GPUs)\n"]},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"9732739906614f54b2ced29928962e96","version_major":2,"version_minor":0},"text/plain":["Loading weights:   0%|          | 0/883 [00:00<?, ?it/s]"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["\n","✅ Model loaded\n","   Memory footprint : 3.17 GB\n","   Gradient checkpointing   : enabled\n","   prepare_model_for_kbit   : done ✅\n"]}],"source":["# ── 4-bit NF4 quantisation config ────────────────────────────────────────────\n","# double_quant saves an extra ~0.4 GB with negligible quality loss\n","bnb_config = BitsAndBytesConfig(\n","    load_in_4bit=True,\n","    bnb_4bit_quant_type=\"nf4\",\n","    bnb_4bit_compute_dtype=torch.float16,   # FP16: supported on T4 ✅\n","    bnb_4bit_use_double_quant=True,\n",")\n","\n","print(f\"Loading model from: {MODEL_PATH}\")\n","print(\"(4-bit NF4 + double quantisation, device_map='auto' across both GPUs)\")\n","\n","# ── Load model ────────────────────────────────────────────────────────────────\n","# FIX 1: use `dtype` (not deprecated `torch_dtype`)\n","# FIX 2: device_map=\"auto\" lets accelerate split layers across both T4 GPUs\n","model = AutoModelForCausalLM.from_pretrained(\n","    MODEL_PATH,\n","    quantization_config=bnb_config,\n","    device_map=\"auto\" ,             # ✅ uses BOTH T4 GPUs\n","    dtype=torch.float16,            # ✅ FP16 (BF16 is not supported on T4)\n","    attn_implementation=\"eager\",    # safer than flash-attn on older GPUs\n",")\n","\n","print(f\"\\n✅ Model loaded\")\n","print(f\"   Memory footprint : {model.get_memory_footprint() / 1e9:.2f} GB\")\n","\n","# ── FIX 3: prepare_model_for_kbit_training ────────────────────────────────────\n","# This is critical for stable QLoRA:\n","#   - Casts LayerNorm weights to float32 (prevents NaN gradients)\n","#   - Handles gradient checkpointing safely with quantised layers\n","#   - Was incorrectly removed in the Gemma 4 notebook\n","gc.collect()\n","torch.cuda.empty_cache()\n","\n","model = prepare_model_for_kbit_training(\n","    model,\n","    use_gradient_checkpointing=True,\n","    gradient_checkpointing_kwargs={\"use_reentrant\": False},  # safer for multi-GPU\n",")\n","\n","print(\"   Gradient checkpointing   : enabled\")\n","print(\"   prepare_model_for_kbit   : done ✅\")"]},{"cell_type":"markdown","id":"fb5c0ad1","metadata":{"papermill":{"duration":0.005028,"end_time":"2026-10-23T05:55:45.093663+00:00","exception":false,"start_time":"2026-10-23T05:55:45.088635+00:00","status":"completed"},"tags":[]},"source":["## 8. Apply LoRA Adapters\n","\n","Gemma 3 (text-only) has a flat module hierarchy — no `language_model.*` prefix.\n","We target all attention projection layers and the MLP gating layers for best coverage.\n","\n","> **♻️ Resuming note:** When resuming, the LoRA adapter weights are\n","> automatically loaded from the checkpoint by `SFTTrainer`. Just run\n","> this cell as usual and proceed to training."]},{"cell_type":"code","execution_count":9,"id":"505621af","metadata":{"execution":{"iopub.execute_input":"2026-10-23T05:55:45.106275Z","iopub.status.busy":"2026-10-23T05:55:45.105513Z","iopub.status.idle":"2026-10-23T05:55:45.887951Z","shell.execute_reply":"2026-10-23T05:55:45.887096Z"},"papermill":{"duration":0.790677,"end_time":"2026-10-23T05:55:45.889602+00:00","exception":false,"start_time":"2026-10-23T05:55:45.098925+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["trainable params: 32,788,480 || all params: 4,332,867,952 || trainable%: 0.7567\n"]}],"source":["lora_config = LoraConfig(\n","    r=LORA_R,\n","    lora_alpha=LORA_ALPHA,\n","    # Gemma 3 text-only module names (no \"language_model\" prefix unlike Gemma 4)\n","    target_modules=[\n","        \"q_proj\", \"k_proj\", \"v_proj\", \"o_proj\",   # attention\n","        \"gate_proj\", \"up_proj\", \"down_proj\",        # MLP\n","    ],\n","    lora_dropout=LORA_DROPOUT,\n","    bias=\"none\",\n","    task_type=\"CAUSAL_LM\",\n",")\n","\n","model = get_peft_model(model, lora_config)\n","# Force any bf16 trainable params (LoRA can inherit bf16 from Gemma 3's checkpoint\n","# config) to fp16 — T4 has no bf16 gradient-scaling kernel, which is what's\n","# throwing \"_amp_foreach_non_finite_check_and_unscale_cuda not implemented for BFloat16\".\n","for param in model.parameters():\n","    if param.requires_grad and param.dtype == torch.bfloat16:\n","        param.data = param.data.to(torch.float16)\n","model.print_trainable_parameters()\n","# Expected: ~0.4–0.8% of total params for r=16 on 4B model\n","# Example:  trainable params: 27,262,976 || all params: 4,299,694,080 || trainable%: 0.634"]},{"cell_type":"markdown","id":"d2b7b4ba","metadata":{"papermill":{"duration":0.005997,"end_time":"2026-10-23T05:55:45.90086+00:00","exception":false,"start_time":"2026-10-23T05:55:45.894863+00:00","status":"completed"},"tags":[]},"source":["## 9. Train\n","\n","### Key fixes vs. the previous Gemma 4 notebook\n","\n","| Setting | Old (broken) | New (fixed) |\n","|---|---|---|\n","| `bf16` | `True` (T4 ❌) | `False` ✅ |\n","| `fp16` | `False` | `True` ✅ |\n","| `load_best_model_at_end` | `True` (hangs on quantised models) | `False` ✅ |\n","| `save_steps` | `15` | `10` (more frequent, survives Kaggle kills) ✅ |\n","\n","### Checkpoint schedule\n","\n","| Setting | Value | Meaning |\n","|---|---|---|\n","| `save_strategy` | `\"steps\"` | Save after every N steps |\n","| `save_steps` | `10` | Checkpoint every 10 optimiser step