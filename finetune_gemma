nd fall back automatically so this cell works\n","# regardless of exactly which trl version ends up installed.\n","try:\n","    trainer = SFTTrainer(\n","        model = model,\n","        train_dataset = ds[\"train\"],\n","        eval_dataset = ds[\"validation\"],\n","        args = training_args,\n","        processing_class = tokenizer,\n","    )\n","except TypeError:\n","    trainer = SFTTrainer(\n","        model = model,\n","        train_dataset = ds[\"train\"],\n","        eval_dataset = ds[\"validation\"],\n","        args = training_args,\n","        tokenizer = tokenizer,\n","    )\n","\n","# Gemma 3's forward() requires token_type_ids during training (multimodal arch,\n","# even for text-only use) but the default SFT collator doesn't produce one.\n","_base_collator = trainer.data_collator\n","\n","def _collator_with_token_type_ids(features):\n","    batch = _base_collator(features)\n","    if \"token_type_ids\" not in batch:\n","        batch[\"token_type_ids\"] = torch.zeros_like(batch[\"input_ids\"])\n","    return batch\n","\n","trainer.data_collator = _collator_with_token_type_ids\n","# ── Training summary ──────────────────────────────────────────────────────────\n","steps_per_epoch = len(ds[\"train\"]) // (BATCH_SIZE * GRAD_ACCUM)\n","total_steps     = steps_per_epoch * EPOCHS\n","\n","print(\"🚀 Starting training …\")\n","print(f\"   Model           : {KAGGLE_MODEL_HANDLE.split('/')[-1]}\")\n","print(f\"   Epochs          : {EPOCHS}\")\n","print(f\"   Steps per epoch : {steps_per_epoch}\")\n","print(f\"   Total steps     : {total_steps}\")\n","print(f\"   Effective batch : {BATCH_SIZE * GRAD_ACCUM}\")\n","print(f\"   Learning rate   : {LR}\")\n","print(f\"   Max seq length  : {MAX_SEQ_LEN}\")\n","print(f\"   Save every      : {SAVE_STEPS} steps\")\n","if _resume_path:\n","    print(f\"   ♻️  Resuming from : {_resume_path}\")\n","else:\n","    print(\"   🆕 Starting fresh\")\n","print()\n","\n","trainer.train(resume_from_checkpoint=_resume_path)"]},